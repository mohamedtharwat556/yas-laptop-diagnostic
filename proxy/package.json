{
  "name": "https-proxy-agent",
  "version": "1.0.0",
  "description": "HTTPS Reverse Proxy for Hardware Agent",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test-proxy.js",
    "setup": "cmd /c setup-all.cmd",
    "setup:cert": "cmd /c setup-cert-openssl.cmd",
    "setup:cert:ps1": "powershell -ExecutionPolicy Bypass -File setup-cert.ps1",
    "setup:cert:mkcert": "cmd /c setup-cert-mkcert.cmd"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy": "^1.18.1",
    "node-forge": "^1.3.0"
  }
}

